{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Blink Reminder",
  "version": "0.1.0",
  "identifier": "net.matteson.blinkreminder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "reminder",
        "title": "Blink Reminder",
        "width": 420,
        "height": 150,
        "visible": false,
        "focus": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
